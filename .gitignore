target/
.DS_Store
/gatk/
/picard/
/htsjdk/
/target
tools/asm-conformance/out_*.txt

# Covering-array corpora are oracle output. A local run happens in an emulated container, and the
# bit-identity contract only accepts goldens produced on real x86-64 CI, so a local copy must not
# be committed. The two below are the exception: they were produced by CI and are re-derived on
# every run, which is what makes the measured argument coverage checkable.
#
# The rule is a file glob rather than `tools/coverage/corpus/`: git does not descend into an
# excluded directory, so a per-file negation under one has no effect.
tools/coverage/corpus/*
# {{BEGIN coverage corpora}}
!tools/coverage/corpus/AddOATag.t2.txt
!tools/coverage/corpus/CollectAlignmentSummaryMetrics.t2.txt
!tools/coverage/corpus/CollectQualityYieldMetrics.t2.txt
!tools/coverage/corpus/SortSam.t2.txt
!tools/coverage/corpus/CleanSam.t2.txt
!tools/coverage/corpus/SamFormatConverter.t2.txt
!tools/coverage/corpus/BedToIntervalList.t2.txt
!tools/coverage/corpus/IntervalListToBed.t2.txt
!tools/coverage/corpus/NormalizeFasta.t2.txt
!tools/coverage/corpus/AddOrReplaceReadGroups.t2.txt
!tools/coverage/corpus/MergeSamFiles.t2.txt
!tools/coverage/corpus/ReplaceSamHeader.t2.txt
!tools/coverage/corpus/CalculateReadGroupChecksum.t2.txt
!tools/coverage/corpus/NonNFastaSize.t2.txt
!tools/coverage/corpus/ScatterIntervalsByNs.t2.txt
!tools/coverage/corpus/ViewSam.t2.txt
!tools/coverage/corpus/BamIndexStats.t2.txt
!tools/coverage/corpus/ReorderSam.t2.txt
!tools/coverage/corpus/CreateSequenceDictionary.t2.txt
!tools/coverage/corpus/DownsampleSam.t2.txt
!tools/coverage/corpus/FixMateInformation.t2.txt
!tools/coverage/corpus/MeanQualityByCycle.t2.txt
!tools/coverage/corpus/CollectBaseDistributionByCycle.t2.txt
!tools/coverage/corpus/QualityScoreDistribution.t2.txt
!tools/coverage/corpus/SetNmMdAndUqTags.t2.txt
!tools/coverage/corpus/RevertSam.t2.txt
!tools/coverage/corpus/ExtractSequences.t2.txt
!tools/coverage/corpus/IntervalListTools.t2.txt
!tools/coverage/corpus/PositionBasedDownsampleSam.t2.txt
!tools/coverage/corpus/ValidateSamFile.t2.txt
!tools/coverage/corpus/FilterSamReads.t2.txt
# {{END coverage corpora}}

# Candidate goldens for golden-pending suites. CI publishes them as an artefact from a real
# x86-64 run; a copy produced locally must not be committed (decision 0008).
tools/conformance/pending/

# Candidate coverage measurements for `pending` covering arrays, on the same rule: the
# number is published by CI from a real x86-64 run, and committing it is what makes the
# array measured.
tools/coverage/pending/

# Fuzzer findings are oracle output produced locally, in an emulated container. CI publishes them
# from a real x86-64 run as an artefact; a local copy must not be committed (decision 0008).
tools/fuzz/findings/
__pycache__/
*.pyc
